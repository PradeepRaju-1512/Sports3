# Portable PostgreSQL connection string (auto-SSL for cloud hosts, no SSL for localhost)
# In production (NODE_ENV=production), DATABASE_URL is required and startup fails fast if unreachable.
# In local development, leave unset to run with zero-crash in-memory demo fallback.
DATABASE_URL=

# Explicitly enable demo persona switching ONLY in local/staging dev when set to "true"
ENABLE_DEMO_SWITCHER=false

# Secret used to sign HMAC session cookies and Bearer tokens.
# REQUIRED in production (must be 32+ random characters, not a placeholder).
SESSION_SECRET=

# Comma-separated list of explicit allowed CORS origins (same-origin requests are always allowed).
# Example: CORS_ORIGIN=https://sports.iiitt.ac.in,https://iiitt-sports.onrender.com
CORS_ORIGIN=

# Reverse proxy hop count for Express `trust proxy` (e.g. 1 on Render/Cloud Run/Nginx, false locally)
TRUST_PROXY=1

# Optional Google OAuth 2.0 credentials for @iiitt.ac.in institutional sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL used for OAuth callback (e.g. https://sports.iiitt.ac.in)
APP_BASE_URL=http://localhost:3000

# Optional password assigned to seeded accounts during `npm run db:seed` (dev/staging only)
SEED_USER_PASSWORD=

# Server port (defaults to 3000)
PORT=3000
