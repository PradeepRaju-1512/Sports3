# Portable PostgreSQL connection string (auto-SSL for cloud hosts, no SSL for localhost)
# In production (NODE_ENV=production), DATABASE_URL is required and startup fails fast if unreachable.
# In local development, leave unset to run with zero-crash in-memory demo fallback.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iiitt_sports

# Explicitly enable demo persona switching ONLY when set to "true"
ENABLE_DEMO_SWITCHER=true

# Secret used to sign HMAC session Bearer tokens (set a strong 32+ char secret in production)
SESSION_SECRET=change-me-to-a-long-random-secret

# Optional comma-separated list of allowed CORS origins (same-origin requests are always allowed)
CORS_ORIGIN=http://localhost:3000

# Server port (defaults to 3000)
PORT=3000
