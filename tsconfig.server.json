{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist/server",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/server/**/*",
    "src/db/**/*",
    "src/types/**/*",
    "src/scoring/types.ts",
    "src/scoring/engine.ts",
    "src/scoring/reducers.ts"
  ]
}